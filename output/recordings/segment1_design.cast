[0.005713, "o", "\r\n########################################################################\r\n"]
[0.006217, "o", "# SEGMENT 1/6 - Problem and design: merge quantization into the existing read path\r\n########################################################################\r\n\r\n"]
[2.00815, "o", "\r\n\u001b[1;36m$ grep the existing normalized read path that every accessor already uses\u001b[0m\r\n"]
[2.010629, "o", "2316:static cgltf_float cgltf_component_read_float(const void* in, cgltf_component_type component_type, cgltf_bool normalized, cgltf_component_type quantized_bits)\r\n2380:\t\tout[0] = cgltf_component_read_float(element, component_type, normalized, quantized_bits);\r\n2381:\t\tout[1] = cgltf_component_read_float(element + 1, component_type, normalized, quantized_bits);\r\n2382:\t\tout[2] = cgltf_component_read_float(element + 4, component_type, normalized, quantized_bits);\r\n2383:\t\tout[3] = cgltf_component_read_float(element + 5, component_type, normalized, quantized_bits);\r\n2389:\t\tout[0] = cgltf_component_read_float(element, component_type, normalized, quantized_bits);\r\n"]
[4.01325, "o", "\r\n\u001b[1;36m$ new public types on cgltf_accessor (no parallel parser is introduced)\u001b[0m\r\n"]
[4.015652, "o", "321:typedef enum cgltf_mesh_quantization_color_space {\r\n322:\tcgltf_mesh_quantization_color_space_none,\r\n323:\tcgltf_mesh_quantization_color_space_srgb,\r\n324:\tcgltf_mesh_quantization_color_space_max_enum\r\n325:} cgltf_mesh_quantization_color_space;\r\n327:typedef struct cgltf_mesh_quantization\r\n331:\tcgltf_mesh_quantization_color_space color_space;\r\n332:} cgltf_mesh_quantization;\r\n"]
[6.018549, "o", "\r\n\u001b[1;36m$ the dequant transform is one extra parameter on the shared function\u001b[0m\r\n"]
[6.020513, "o", "static cgltf_float cgltf_component_read_float(const void* in, cgltf_component_type component_type, cgltf_bool normalized, cgltf_component_type quantized_bits)\r\n{\r\n\tif (component_type == cgltf_component_type_r_32f)\r\n\t{\r\n\t\treturn *((const float*) in);\r\n\t}\r\n\r\n\tif (normalized)\r\n\t{\r\n\t\tswitch (component_type)\r\n\t\t{\r\n\t\t\t// note: glTF spec doesn't currently define normalized conversions for 32-bit integers\r\n\t\t\tcase cgltf_component_type_r_16:\r\n\t\t\t\treturn *((const int16_t*) in) / (cgltf_float)32767;\r\n\t\t\tcase cgltf_component_type_r_16u:\r\n\t\t\t\treturn *((const uint16_t*) in) / (cgltf_float)65535;\r\n\t\t\tcase cgltf_component_type_r_8:\r\n\t\t\t\treturn *((const int8_t*) in) / (cgltf_float)127;\r\n\t\t\tcase cgltf_component_type_r_8u:\r\n\t\t\t\treturn *((const uint8_t*) in) / (cgltf_float)255;\r\n\t\t\tdefault:\r\n\t\t\t\treturn 0;\r\n\t\t}\r\n\t}\r\n\r\n\t/*\r\n\t * KHR_mesh_quantization: the stored integer is an affine encoding of the\r\n\t * dequantized value, f = raw * multiplier + offset. This is the same\r\n\t * read path as every other accessor; only the transform differs.\r\n\t */\r\n\tif (quantized_bits != cgltf_component_type_invalid)\r\n\t{\r\n\t\tswitch (quantized_bits)\r\n\t\t{\r\n\t\t\tcase cgltf_component_type_r_8:\r\n\t\t\t\treturn (cgltf_float)*((const int8_t*) in) * (1.0f / 127.0f);\r\n\t\t\tcase cgltf_component_type_r_16:\r\n\t\t\t\treturn (cgltf_float)*((const int16_t*) in) * (1.0f / 32767.0f);\r\n\t\t\tcase cgltf_component_type_r_8u:\r\n\t\t\t\treturn (cgltf_float)*((const uint8_t*) in) * (1.0f / 255.0f);\r\n\t\t\tcase cgltf_component_type_r_16u:\r\n\t\t\t\treturn (cgltf_float)*((const uint16_t*) in) * (1.0f / 65535.0f);\r\n\t\t\tdefault:\r\n\t\t\t\treturn 0;\r\n\t\t}\r\n"]
