+			q[i * 4 + 0] = (int8_t)(int)xr;
+			q[i * 4 + 1] = (int8_t)(int)yr;
+			q[i * 4 + 2] = (int8_t)(int)zr;
+		}
+	}
+	else
+	{
+		const float max = 32767.0f;
+		int16_t* q = (int16_t*)data;
+
+		for (cgltf_size i = 0; i < count; ++i)
+		{
+			float x = (float)q[i * 4 + 0];
+			float y = (float)q[i * 4 + 1];
+			float z = (float)q[i * 4 + 2] - cgltf_meshopt_fabsf(x) - cgltf_meshopt_fabsf(y);
+
+			float t = (z >= 0.f) ? 0.f : z;
+			x += (x >= 0.f) ? t : -t;
+			y += (y >= 0.f) ? t : -t;
+
+			float l = cgltf_meshopt_sqrtf(x * x + y * y + z * z);
+			float s = max / l;
+
+			float xr = x * s + (x >= 0.f ? 0.5f : -0.5f);
+			float yr = y * s + (y >= 0.f ? 0.5f : -0.5f);
+			float zr = z * s + (z >= 0.f ? 0.5f : -0.5f);
+
+			q[i * 4 + 0] = (int16_t)(int)xr;
+			q[i * 4 + 1] = (int16_t)(int)yr;
+			q[i * 4 + 2] = (int16_t)(int)zr;
+		}
+	}
+}
