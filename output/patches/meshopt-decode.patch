+			   prevent FMA contraction from changing the rounded result */
+			float xr = x * s + (x >= 0.f ? 0.5f : -0.5f);
+			float yr = y * s + (y >= 0.f ? 0.5f : -0.5f);
+			float zr = z * s + (z >= 0.f ? 0.5f : -0.5f);
