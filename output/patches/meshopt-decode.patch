+static void cgltf_meshopt_decode_filter_quat(int16_t* data, cgltf_size count)
+{
+	const float scale = 32767.f / cgltf_meshopt_sqrtf(2.f);
+
+	for (cgltf_size i = 0; i < count; ++i)
+	{
+		int sf = data[i * 4 + 3] | 3;
+		float s = (float)sf;
+
+		float x = (float)data[i * 4 + 0];
+		float y = (float)data[i * 4 + 1];
+		float z = (float)data[i * 4 + 2];
+
+		float ws = s * s;
+		float ww = ws * 2.f - x * x - y * y - z * z;
+		float w = cgltf_meshopt_sqrtf(ww >= 0.f ? ww : 0.f);
+
+		float ss = scale / s;
+
+		/* distinct float temporaries, matching the reference rounding behavior */
+		float xr = x * ss + (x >= 0.f ? 0.5f : -0.5f);
+		float yr = y * ss + (y >= 0.f ? 0.5f : -0.5f);
+		float zr = z * ss + (z >= 0.f ? 0.5f : -0.5f);
+		float wr = w * ss + 0.5f;
+
+		int xf = (int)xr;
+		int yf = (int)yr;
+		int zf = (int)zr;
+		int wf = (int)wr;
+
+		int qc = data[i * 4 + 3] & 3;
+
+		data[i * 4 + ((qc + 1) & 3)] = (int16_t)xf;
+		data[i * 4 + ((qc + 2) & 3)] = (int16_t)yf;
+		data[i * 4 + ((qc + 3) & 3)] = (int16_t)zf;
+		data[i * 4 + ((qc + 0) & 3)] = (int16_t)wf;
+	}
+}
