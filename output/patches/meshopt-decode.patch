+/*
+ * KHR_meshopt_compression / EXT_meshopt_compression decoder.
+ *
+ * Scalar C99 port of the reference bitstream decoder from the meshoptimizer
+ * library (vertex/index codecs version 0..1 and the post-decode filters).
+ * Every compressed buffer view is decoded into the view's data pointer, which
+ * is the single entry point (cgltf_buffer_view_data) used by all accessor
+ * reads, so the existing accessor paths are shared and not duplicated.
+ */
+
+#define CGLTF_MESHOPT_VERTEX_HEADER 0xa0
+#define CGLTF_MESHOPT_INDEX_HEADER 0xe0
+#define CGLTF_MESHOPT_SEQUENCE_HEADER 0xd0
+#define CGLTF_MESHOPT_VERTEX_VERSION 1
+#define CGLTF_MESHOPT_INDEX_VERSION 1
+#define CGLTF_MESHOPT_VERTEX_BLOCK_SIZE_BYTES 8192
+#define CGLTF_MESHOPT_VERTEX_BLOCK_MAX_SIZE 256
+#define CGLTF_MESHOPT_BYTE_GROUP_SIZE 16
+#define CGLTF_MESHOPT_BYTE_GROUP_DECODE_LIMIT 24
+#define CGLTF_MESHOPT_TAIL_MIN_SIZE_V0 32
+#define CGLTF_MESHOPT_TAIL_MIN_SIZE_V1 24
+
+static uint32_t cgltf_meshopt_rotate(uint32_t v, int r)
+{
+	return (v << r) | (v >> ((32 - r) & 31));
+}
+
+static cgltf_size cgltf_meshopt_get_vertex_block_size(cgltf_size vertex_size)
+{
+	/* the block size is part of the bitstream format and must stay fixed */
+	cgltf_size result = (CGLTF_MESHOPT_VERTEX_BLOCK_SIZE_BYTES / vertex_size) & ~(CGLTF_MESHOPT_BYTE_GROUP_SIZE - 1);
+
+	return (result < CGLTF_MESHOPT_VERTEX_BLOCK_MAX_SIZE) ? result : CGLTF_MESHOPT_VERTEX_BLOCK_MAX_SIZE;
+}
+
+/* Reads one 16-byte group encoded with the given bit width (0, 1, 2, 4 or 8). */
+static const uint8_t* cgltf_meshopt_decode_bytes_group(const uint8_t* data, uint8_t* buffer, int bits)
+{
+#define CGLTF_MESHOPT_READ() byte = *data++
+#define CGLTF_MESHOPT_NEXT(bits) enc = byte >> (8 - (bits)), byte <<= (bits), encv = *data_var, *buffer++ = (enc == (1 << (bits)) - 1) ? encv : enc, data_var += (enc == (1 << (bits)) - 1)
+
+	uint8_t byte, enc, encv;
+	const uint8_t* data_var;
+
+	switch (bits)
+	{
+	case 0:
+		memset(buffer, 0, CGLTF_MESHOPT_BYTE_GROUP_SIZE);
+		return data;
+	case 1:
+		data_var = data + 2;
+
+		/* 2 groups with 8 1-bit values in each byte (reversed bit order) */
+		CGLTF_MESHOPT_READ();
+		byte = (uint8_t)(((byte * 0x80200802ull) & 0x0884422110ull) * 0x0101010101ull >> 32);
+		CGLTF_MESHOPT_NEXT(1), CGLTF_MESHOPT_NEXT(1), CGLTF_MESHOPT_NEXT(1), CGLTF_MESHOPT_NEXT(1),
+			CGLTF_MESHOPT_NEXT(1), CGLTF_MESHOPT_NEXT(1), CGLTF_MESHOPT_NEXT(1), CGLTF_MESHOPT_NEXT(1);
+		CGLTF_MESHOPT_READ();
+		byte = (uint8_t)(((byte * 0x80200802ull) & 0x0884422110ull) * 0x0101010101ull >> 32);
+		CGLTF_MESHOPT_NEXT(1), CGLTF_MESHOPT_NEXT(1), CGLTF_MESHOPT_NEXT(1), CGLTF_MESHOPT_NEXT(1),
+			CGLTF_MESHOPT_NEXT(1), CGLTF_MESHOPT_NEXT(1), CGLTF_MESHOPT_NEXT(1), CGLTF_MESHOPT_NEXT(1);
+
+		return data_var;
+	case 2:
+		data_var = data + 4;
+
+		/* 4 groups with 4 2-bit values in each byte */
+		CGLTF_MESHOPT_READ(), CGLTF_MESHOPT_NEXT(2), CGLTF_MESHOPT_NEXT(2), CGLTF_MESHOPT_NEXT(2), CGLTF_MESHOPT_NEXT(2);
+		CGLTF_MESHOPT_READ(), CGLTF_MESHOPT_NEXT(2), CGLTF_MESHOPT_NEXT(2), CGLTF_MESHOPT_NEXT(2), CGLTF_MESHOPT_NEXT(2);
+		CGLTF_MESHOPT_READ(), CGLTF_MESHOPT_NEXT(2), CGLTF_MESHOPT_NEXT(2), CGLTF_MESHOPT_NEXT(2), CGLTF_MESHOPT_NEXT(2);
+		CGLTF_MESHOPT_READ(), CGLTF_MESHOPT_NEXT(2), CGLTF_MESHOPT_NEXT(2), CGLTF_MESHOPT_NEXT(2), CGLTF_MESHOPT_NEXT(2);
+
+		return data_var;
+	case 4:
+		data_var = data + 8;
+
+		/* 8 groups with 2 4-bit values in each byte */
+		CGLTF_MESHOPT_READ(), CGLTF_MESHOPT_NEXT(4), CGLTF_MESHOPT_NEXT(4);
+		CGLTF_MESHOPT_READ(), CGLTF_MESHOPT_NEXT(4), CGLTF_MESHOPT_NEXT(4);
+		CGLTF_MESHOPT_READ(), CGLTF_MESHOPT_NEXT(4), CGLTF_MESHOPT_NEXT(4);
+		CGLTF_MESHOPT_READ(), CGLTF_MESHOPT_NEXT(4), CGLTF_MESHOPT_NEXT(4);
+		CGLTF_MESHOPT_READ(), CGLTF_MESHOPT_NEXT(4), CGLTF_MESHOPT_NEXT(4);
+		CGLTF_MESHOPT_READ(), CGLTF_MESHOPT_NEXT(4), CGLTF_MESHOPT_NEXT(4);
+		CGLTF_MESHOPT_READ(), CGLTF_MESHOPT_NEXT(4), CGLTF_MESHOPT_NEXT(4);
+		CGLTF_MESHOPT_READ(), CGLTF_MESHOPT_NEXT(4), CGLTF_MESHOPT_NEXT(4);
+
+		return data_var;
+	case 8:
+		memcpy(buffer, data, CGLTF_MESHOPT_BYTE_GROUP_SIZE);
+		return data + CGLTF_MESHOPT_BYTE_GROUP_SIZE;
+	default:
+		return NULL;
+	}
+
+#undef CGLTF_MESHOPT_READ
+#undef CGLTF_MESHOPT_NEXT
+}
+
+static const uint8_t* cgltf_meshopt_decode_bytes(const uint8_t* data, const uint8_t* data_end,
+	uint8_t* buffer, cgltf_size buffer_size, const int* bits)
+{
+	/* round the number of groups up to sets of 4 to get the header size */
+	cgltf_size header_size = (buffer_size / CGLTF_MESHOPT_BYTE_GROUP_SIZE + 3) / 4;
+	if ((cgltf_size)(data_end - data) < header_size)
+		return NULL;
+
+	const uint8_t* header = data;
+	data += header_size;
+
+	for (cgltf_size i = 0; i < buffer_size; i += CGLTF_MESHOPT_BYTE_GROUP_SIZE)
+	{
+		if ((cgltf_size)(data_end - data) < CGLTF_MESHOPT_BYTE_GROUP_DECODE_LIMIT)
+			return NULL;
+
+		cgltf_size header_offset = i / CGLTF_MESHOPT_BYTE_GROUP_SIZE;
+		int bitsk = (header[header_offset / 4] >> ((header_offset % 4) * 2)) & 3;
+
+		data = cgltf_meshopt_decode_bytes_group(data, buffer + i, bits[bitsk]);
+		if (data == NULL)
+			return NULL;
+	}
+
+	return data;
+}
+
+/* Undo delta coding for one 4-byte channel made of 1-, 2- or 4-byte components. */
+static void cgltf_meshopt_decode_deltas_4(const uint8_t* buffer, uint8_t* transposed,
+	cgltf_size vertex_count, cgltf_size vertex_size, const uint8_t* last_vertex, int component_size, int xor_rotate, int rot)
+{
+	for (cgltf_size k = 0; k < 4; k += component_size)
+	{
+		cgltf_size vertex_offset = k;
+
+		uint32_t p = 0;
+		for (cgltf_size j = 0; j < (cgltf_size)component_size; ++j)
+			p |= (uint32_t)last_vertex[j] << (8 * j);
+
+		for (cgltf_size i = 0; i < vertex_count; ++i)
+		{
+			uint32_t v = 0;
+			for (cgltf_size j = 0; j < (cgltf_size)component_size; ++j)
+				v |= (uint32_t)buffer[i + vertex_count * j] << (8 * j);
+
+			if (xor_rotate)
+				v = cgltf_meshopt_rotate(v, rot) ^ p;
+			else
+			{
+				/* unzigzag: (0 - (v & 1)) ^ (v >> 1), truncated to the component width */
+				uint32_t mask = component_size == 1 ? 0xffu : (component_size == 2 ? 0xffffu : 0xffffffffu);
+				v = (((0 - (v & 1)) ^ (v >> 1)) & mask) + p;
+			}
+
+			for (cgltf_size j = 0; j < (cgltf_size)component_size; ++j)
+				transposed[vertex_offset + j] = (uint8_t)(v >> (j * 8));
+
+			p = v;
+			vertex_offset += vertex_size;
+		}
+
+		buffer += vertex_count * component_size;
+		last_vertex += component_size;
+	}
+}
+
+static const uint8_t* cgltf_meshopt_decode_vertex_block(const uint8_t* data, const uint8_t* data_end,
+	uint8_t* vertex_data, cgltf_size vertex_count, cgltf_size vertex_size,
+	uint8_t last_vertex[256], const uint8_t* channels, int version)
+{
+	uint8_t buffer[CGLTF_MESHOPT_VERTEX_BLOCK_MAX_SIZE * 4];
+	uint8_t transposed[CGLTF_MESHOPT_VERTEX_BLOCK_SIZE_BYTES];
+
+	cgltf_size vertex_count_aligned = (vertex_count + CGLTF_MESHOPT_BYTE_GROUP_SIZE - 1) & ~(CGLTF_MESHOPT_BYTE_GROUP_SIZE - 1);
+
+	cgltf_size control_size = version == 0 ? 0 : vertex_size / 4;
+	if ((cgltf_size)(data_end - data) < control_size)
+		return NULL;
+
+	const uint8_t* control = data;
+	data += control_size;
+
+	static const int bits_v0[4] = {0, 2, 4, 8};
+	static const int bits_v1[5] = {0, 1, 2, 4, 8};
+
+	for (cgltf_size k = 0; k < vertex_size; k += 4)
+	{
+		uint8_t ctrl_byte = version == 0 ? 0 : control[k / 4];
+
+		for (cgltf_size j = 0; j < 4; ++j)
+		{
+			int ctrl = (ctrl_byte >> (j * 2)) & 3;
+
+			if (ctrl == 3)
+			{
+				/* literal encoding */
+				if ((cgltf_size)(data_end - data) < vertex_count)
+					return NULL;
+
+				memcpy(buffer + j * vertex_count, data, vertex_count);
+				data += vertex_count;
+			}
+			else if (ctrl == 2)
+			{
+				/* zero encoding */
+				memset(buffer + j * vertex_count, 0, vertex_count);
+			}
+			else
+			{
+				const int* bits = version == 0 ? bits_v0 : bits_v1 + ctrl;
+				data = cgltf_meshopt_decode_bytes(data, data_end, buffer + j * vertex_count, vertex_count_aligned, bits);
+				if (data == NULL)
+					return NULL;
+			}
+		}
+
+		int channel = version == 0 ? 0 : channels[k / 4];
+
+		switch (channel & 3)
+		{
+		case 0:
+			cgltf_meshopt_decode_deltas_4(buffer, transposed + k, vertex_count, vertex_size, last_vertex + k, 1, 0, 0);
+			break;
+		case 1:
+			cgltf_meshopt_decode_deltas_4(buffer, transposed + k, vertex_count, vertex_size, last_vertex + k, 2, 0, 0);
+			break;
+		case 2:
+			cgltf_meshopt_decode_deltas_4(buffer, transposed + k, vertex_count, vertex_size, last_vertex + k, 4, 1, (32 - (channel >> 4)) & 31);
+			break;
+		default:
+			return NULL; /* invalid channel type */
+		}
+	}
+
+	memcpy(vertex_data, transposed, vertex_count * vertex_size);
+	memcpy(last_vertex, &transposed[vertex_size * (vertex_count - 1)], vertex_size);
+
+	return data;
+}
+
+/* Returns 0 on success; negative values distinguish bad headers (-1), truncated data (-2) and trailing bytes (-3). */
+static int cgltf_meshopt_decode_vertex_buffer(uint8_t* destination, cgltf_size vertex_count, cgltf_size vertex_size,
+	const uint8_t* buffer, cgltf_size buffer_size)
+{
+	if (buffer_size < 1)
+		return -2;
+
+	uint8_t data_header = buffer[0];
+
+	if ((data_header & 0xf0) != CGLTF_MESHOPT_VERTEX_HEADER)
+		return -1;
+
+	int version = data_header & 0x0f;
+	if (version > CGLTF_MESHOPT_VERTEX_VERSION)
+		return -1;
+
+	const uint8_t* data = buffer + 1;
+	const uint8_t* data_end = buffer + buffer_size;
+
+	cgltf_size tail_size = vertex_size + (version == 0 ? 0 : vertex_size / 4);
+	cgltf_size tail_size_min = version == 0 ? CGLTF_MESHOPT_TAIL_MIN_SIZE_V0 : CGLTF_MESHOPT_TAIL_MIN_SIZE_V1;
+	cgltf_size tail_size_pad = tail_size < tail_size_min ? tail_size_min : tail_size;
+
+	if ((cgltf_size)(data_end - data) < tail_size_pad)
+		return -2;
+
+	const uint8_t* tail = data_end - tail_size;
+
+	uint8_t last_vertex[256];
+	memcpy(last_vertex, tail, vertex_size);
+
+	const uint8_t* channels = version == 0 ? NULL : tail + vertex_size;
+
+	cgltf_size vertex_block_size = cgltf_meshopt_get_vertex_block_size(vertex_size);
+	cgltf_size vertex_offset = 0;
+
+	while (vertex_offset < vertex_count)
+	{
+		cgltf_size block_size = (vertex_offset + vertex_block_size < vertex_count) ? vertex_block_size : vertex_count - vertex_offset;
+
+		data = cgltf_meshopt_decode_vertex_block(
+			data, data_end, destination + vertex_offset * vertex_size, block_size, vertex_size, last_vertex, channels, version);
+		if (data == NULL)
+			return -2;
+
+		vertex_offset += block_size;
+	}
+
+	if ((cgltf_size)(data_end - data) != tail_size_pad)
+		return -3;
+
+	return 0;
+}
+
+static uint32_t cgltf_meshopt_decode_vbyte(const uint8_t** data)
+{
+	uint8_t lead = *(*data)++;
+
+	/* fast path: single byte */
+	if (lead < 128)
+		return lead;
+
+	/* slow path: up to 4 extra bytes; the loop always terminates on malformed data */
+	uint32_t result = lead & 127;
+	unsigned int shift = 7;
+
+	for (int i = 0; i < 4; ++i)
+	{
+		uint8_t group = *(*data)++;
+		result |= (uint32_t)(group & 127) << shift;
+		shift += 7;
+
+		if (group < 128)
+			break;
+	}
+
+	return result;
+}
+
+static uint32_t cgltf_meshopt_decode_index(const uint8_t** data, uint32_t last)
+{
+	uint32_t v = cgltf_meshopt_decode_vbyte(data);
+	int32_t d = (int32_t)((v >> 1) ^ (0 - (v & 1)));
+
+	return last + (uint32_t)d;
+}
+
+static void* cgltf_meshopt_write_triangle(void* destination, cgltf_size index_size, uint32_t a, uint32_t b, uint32_t c)
+{
+	if (index_size == 2)
+	{
+		uint16_t* tri = (uint16_t*)destination;
+		tri[0] = (uint16_t)a;
+		tri[1] = (uint16_t)b;
+		tri[2] = (uint16_t)c;
+		return tri + 3;
+	}
+	else
+	{
+		uint32_t* tri = (uint32_t*)destination;
+		tri[0] = a;
+		tri[1] = b;
+		tri[2] = c;
+		return tri + 3;
+	}
+}
+
+static int cgltf_meshopt_decode_index_buffer(uint8_t* destination, cgltf_size index_count, cgltf_size index_size,
+	const uint8_t* buffer, cgltf_size buffer_size)
+{
+	/* the minimum valid encoding is a header, 1 byte per triangle and a 16-byte codeaux table */
+	if (buffer_size < 1 + index_count / 3 + 16)
+		return -2;
+
+	if ((buffer[0] & 0xf0) != CGLTF_MESHOPT_INDEX_HEADER)
+		return -1;
+
+	int version = buffer[0] & 0x0f;
+	if (version > CGLTF_MESHOPT_INDEX_VERSION)
+		return -1;
+
+	uint32_t vertexfifo[16];
+	uint32_t edgefifo[16][2];
+	memset(edgefifo, 0xff, sizeof(edgefifo));
+	memset(vertexfifo, 0xff, sizeof(vertexfifo));
+
+	cgltf_size edgefifooffset = 0;
+	cgltf_size vertexfifooffset = 0;
+
+	uint32_t next = 0;
+	uint32_t last = 0;
+
+	int fecmax = version >= 1 ? 13 : 15;
+
+	const uint8_t* code = buffer + 1;
+	const uint8_t* code_end = code + index_count / 3;
+	const uint8_t* data = code_end;
+
+	/* each triangle reads at most 16 bytes of data; the codeaux table sits at the end */
+	const uint8_t* data_safe_end = buffer + buffer_size - 16;
+	const uint8_t* codeaux_table = data_safe_end;
+
+	void* out = destination;
+
+	while (code < code_end)
+	{
+		uint8_t codetri = *code++;
+
+		if (codetri < 0xf0)
+		{
+			int fe = codetri >> 4;
+
+			uint32_t a = edgefifo[(edgefifooffset - 1 - fe) & 15][0];
+			uint32_t b = edgefifo[(edgefifooffset - 1 - fe) & 15][1];
+			uint32_t c = 0;
+
+			int fec = codetri & 15;
+
+			if (fec < fecmax)
+			{
+				uint32_t cf = vertexfifo[(vertexfifooffset - 1 - fec) & 15];
+
+				c = (fec == 0) ? next : cf;
+
+				if (fec == 0)
+					next += 1;
+
+				/* the fifo push order must match the encoder exactly */
+				vertexfifo[vertexfifooffset] = c;
+				vertexfifooffset = (vertexfifooffset + (fec == 0)) & 15;
+			}
+			else
+			{
+				if (data > data_safe_end)
+					return -2;
+
+				/* fec 13/14 decode into offsets -1/+1 relative to the last index */
+				last = c = (fec != 15) ? last + (uint32_t)(fec * 2 - 27) : cgltf_meshopt_decode_index(&data, last);
+
+				vertexfifo[vertexfifooffset] = c;
+				vertexfifooffset = (vertexfifooffset + 1) & 15;
+			}
+
+			edgefifo[edgefifooffset][0] = c;
+			edgefifo[edgefifooffset][1] = b;
+			edgefifooffset = (edgefifooffset + 1) & 15;
+			edgefifo[edgefifooffset][0] = a;
+			edgefifo[edgefifooffset][1] = c;
+			edgefifooffset = (edgefifooffset + 1) & 15;
+
+			out = cgltf_meshopt_write_triangle(out, index_size, a, b, c);
+		}
+		else
+		{
+			if (codetri < 0xfe)
+			{
+				/* fast path: read codeaux from the table */
+				uint8_t codeaux = codeaux_table[codetri & 15];
+
+				int feb = codeaux >> 4;
+				int fec = codeaux & 15;
+
+				uint32_t a = next++;
+
+				uint32_t bf = vertexfifo[(vertexfifooffset - feb) & 15];
+				uint32_t b = (feb == 0) ? next : bf;
+				if (feb == 0)
+					next += 1;
+
+				uint32_t cf = vertexfifo[(vertexfifooffset - fec) & 15];
+				uint32_t c = (fec == 0) ? next : cf;
+				if (fec == 0)
+					next += 1;
+
+				out = cgltf_meshopt_write_triangle(out, index_size, a, b, c);
+
+				vertexfifo[vertexfifooffset] = a;
+				vertexfifooffset = (vertexfifooffset + 1) & 15;
+				vertexfifo[vertexfifooffset] = b;
+				vertexfifooffset = (vertexfifooffset + (feb == 0)) & 15;
+				vertexfifo[vertexfifooffset] = c;
+				vertexfifooffset = (vertexfifooffset + (fec == 0)) & 15;
+
+				edgefifo[edgefifooffset][0] = b;
+				edgefifo[edgefifooffset][1] = a;
+				edgefifooffset = (edgefifooffset + 1) & 15;
+				edgefifo[edgefifooffset][0] = c;
+				edgefifo[edgefifooffset][1] = b;
+				edgefifooffset = (edgefifooffset + 1) & 15;
+				edgefifo[edgefifooffset][0] = a;
+				edgefifo[edgefifooffset][1] = c;
+				edgefifooffset = (edgefifooffset + 1) & 15;
+			}
+			else
+			{
+				if (data > data_safe_end)
+					return -2;
+
+				/* slow path: read a full byte for codeaux instead of a table lookup */
+				uint8_t codeaux = *data++;
+
+				int fea = codetri == 0xfe ? 0 : 15;
+				int feb = codeaux >> 4;
+				int fec = codeaux & 15;
+
+				/* a zero codeaux is a reset marker */
+				if (codeaux == 0)
+					next = 0;
+
+				uint32_t a = (fea == 0) ? next++ : 0;
+				uint32_t b = (feb == 0) ? next++ : vertexfifo[(vertexfifooffset - feb) & 15];
+				uint32_t c = (fec == 0) ? next++ : vertexfifo[(vertexfifooffset - fec) & 15];
+
+				if (fea == 15)
+					last = a = cgltf_meshopt_decode_index(&data, last);
+				if (feb == 15)
+					last = b = cgltf_meshopt_decode_index(&data, last);
+				if (fec == 15)
+					last = c = cgltf_meshopt_decode_index(&data, last);
+
+				out = cgltf_meshopt_write_triangle(out, index_size, a, b, c);
+
+				vertexfifo[vertexfifooffset] = a;
+				vertexfifooffset = (vertexfifooffset + 1) & 15;
+				vertexfifo[vertexfifooffset] = b;
+				vertexfifooffset = (vertexfifooffset + ((feb == 0) | (feb == 15))) & 15;
+				vertexfifo[vertexfifooffset] = c;
+				vertexfifooffset = (vertexfifooffset + ((fec == 0) | (fec == 15))) & 15;
+
+				edgefifo[edgefifooffset][0] = b;
+				edgefifo[edgefifooffset][1] = a;
+				edgefifooffset = (edgefifooffset + 1) & 15;
+				edgefifo[edgefifooffset][0] = c;
+				edgefifo[edgefifooffset][1] = b;
+				edgefifooffset = (edgefifooffset + 1) & 15;
+				edgefifo[edgefifooffset][0] = a;
+				edgefifo[edgefifooffset][1] = c;
+				edgefifooffset = (edgefifooffset + 1) & 15;
+			}
+		}
+	}
+
+	/* all data bytes must be consumed exactly at the codeaux table boundary */
+	if (data != data_safe_end)
+		return -3;
+
+	return 0;
+}
