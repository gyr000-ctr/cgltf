+/* Self-contained float helpers so the meshopt filters need no external libm.
+   They are bit-exact replacements for the fabsf/sqrtf operations the filters use. */
+static float cgltf_meshopt_fabsf(float x)
+{
+	union { float f; uint32_t u; } v;
+	v.f = x;
+	v.u &= 0x7fffffffu;
+	return v.f;
+}
+
+static float cgltf_meshopt_sqrtf(float xf)
+{
+	if (!(xf > 0.0f))
+		return 0.0f; /* covers NaN and negative inputs, matching the filters' guarded use */
+
+	/* Bit-exact, libm-free sqrtf. Build a close initial estimate using integer
+	   exponent/mantissa decomposition (valid for subnormals too), then run five
+	   double-precision Newton-Raphson iterations; double's 53 bits versus float's
+	   24 leave the result well inside half a float ulp of the exact root, and a
+	   float midpoint can never square to a float, so the narrowing conversion is
+	   correctly rounded. Only integer and multiply/divide instructions are used. */
+	double x = (double)xf;
+
+	union
+	{
+		double d;
+		uint64_t u;
+	} v;
+	v.d = x;
+
+	uint64_t bits = v.u;
+	int exponent = (int)((bits >> 52) & 0x7ff) - 1023;
+	uint64_t mantissa = bits & 0xfffffffffffffULL;
+
+	double mantissa_value;
+
+	if ((bits >> 52 & 0x7ff) == 0)
+	{
+		/* subnormal source: normalize the mantissa */
+		int shift = 0;
+		while (!(mantissa & 0x10000000000000ULL))
+		{
+			mantissa <<= 1;
+			++shift;
+		}
+		mantissa &= 0xfffffffffffffULL;
+		exponent = -1022 - shift;
+
+		union
+		{
+			double d;
+			uint64_t u;
+		} t;
+		t.u = 0x3ff0000000000000ULL | mantissa;
+		mantissa_value = t.d; /* [1, 2) */
+	}
+	else
+	{
+		union
+		{
+			double d;
+			uint64_t u;
+		} t;
+		t.u = 0x3ff0000000000000ULL | mantissa;
+		mantissa_value = t.d * 0.5; /* [0.5, 1) */
+	}
+
+	int out_exponent = (exponent - (exponent & 1)) / 2;
+
+	union
+	{
+		double d;
+		uint64_t u;
+	} estimate;
+	estimate.d = mantissa_value * 1.4142135623730951;
+	int estimate_exponent = (int)((estimate.u >> 52) & 0x7ff) + out_exponent;
+	estimate.u = (estimate.u & 0x800fffffffffffffULL) | ((uint64_t)estimate_exponent << 52);
+
+	double r = estimate.d;
+	r = 0.5 * (r + x / r);
+	r = 0.5 * (r + x / r);
+	r = 0.5 * (r + x / r);
+	r = 0.5 * (r + x / r);
+	r = 0.5 * (r + x / r);
+
+	return (float)r;
+}
