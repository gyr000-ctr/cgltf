+static void cgltf_meshopt_decode_filter_oct(uint8_t* data, cgltf_size count, cgltf_size stride)
+{
+	if (stride == 4)
+	{
+		const float max = 127.0f;
+		int8_t* q = (int8_t*)data;
+
+		for (cgltf_size i = 0; i < count; ++i)
+		{
+			float x = (float)q[i * 4 + 0];
+			float y = (float)q[i * 4 + 1];
+			float z = (float)q[i * 4 + 2] - cgltf_meshopt_fabsf(x) - cgltf_meshopt_fabsf(y);
