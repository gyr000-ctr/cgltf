+static int cgltf_meshopt_decode_index_sequence(uint8_t* destination, cgltf_size index_count, cgltf_size index_size,
+	const uint8_t* buffer, cgltf_size buffer_size)
+{
+	/* the minimum valid encoding is a header, 1 byte per index and a 4-byte tail */
+	if (buffer_size < 1 + index_count + 4)
+		return -2;
+
+	if ((buffer[0] & 0xf0) != CGLTF_MESHOPT_SEQUENCE_HEADER)
+		return -1;
+
+	int version = buffer[0] & 0x0f;
+	if (version > CGLTF_MESHOPT_INDEX_VERSION)
+		return -1;
+
+	const uint8_t* data = buffer + 1;
+	const uint8_t* data_safe_end = buffer + buffer_size - 4;
+
+	uint32_t last[2] = {0, 0};
+
+	for (cgltf_size i = 0; i < index_count; ++i)
+	{
+		if (data >= data_safe_end)
+			return -2;
+
+		uint32_t v = cgltf_meshopt_decode_vbyte(&data);
+
+		uint32_t current = v & 1;
+		v >>= 1;
+
+		int32_t d = (int32_t)((v >> 1) ^ (0 - (v & 1)));
+		uint32_t index = last[current] + (uint32_t)d;
+
+		last[current] = index;
+
+		if (index_size == 2)
+			((uint16_t*)destination)[i] = (uint16_t)index;
+		else
+			((uint32_t*)destination)[i] = index;
+	}
+
+	if (data != data_safe_end)
+		return -3;
+
+	return 0;
+}
