[0.003028, "o", "\r\n\u001b[1;36m======================================================================\u001b[0m\r\n\u001b[1;36m  Segment 1/5  Architecture: shared read entry point, no duplicated parser\u001b[0m\r\n"]
[0.003374, "o", "\u001b[1;36m======================================================================\u001b[0m\r\n"]
[2.005948, "o", "\u001b[1;33m$ grep -n cgltf_decode_meshopt_views\\|cgltf_buffer_view_data(view ../cgltf.h\u001b[0m\r\n"]
[3.010251, "o", "1551:static cgltf_result cgltf_decode_meshopt_views(cgltf_data* data)\r\n1700:\treturn cgltf_decode_meshopt_views(data);\r\n"]
[4.013424, "o", "\u001b[1;33m$ sed -n 1546,1561p ../cgltf.h\u001b[0m\r\n"]
[5.017438, "o", " * Decodes every buffer view carrying a KHR/EXT_meshopt_compression extension.\r\n * Decoded bytes are stored in the existing cgltf_buffer_view::data slot, so every\r\n * accessor entry point (cgltf_buffer_view_data / cgltf_accessor_read_* / unpack /\r\n * sparse) keeps going through the same code path as for uncompressed files.\r\n */\r\nstatic cgltf_result cgltf_decode_meshopt_views(cgltf_data* data)\r\n{\r\n\tcgltf_bool any_compressed = 0;\r\n\tfor (cgltf_size i = 0; i < data->buffer_views_count; ++i)\r\n\t\tany_compressed |= data->buffer_views[i].has_meshopt_compression;\r\n\r\n\tif (!any_compressed)\r\n\t{\r\n\t\treturn cgltf_result_success;\r\n\t}\r\n\r\n"]
[7.023424, "o", "\r\n\u001b[1;36m======================================================================\u001b[0m\r\n\u001b[1;36m  Segment 2/5  Distinguishable error codes\u001b[0m\r\n\u001b[1;36m======================================================================\u001b[0m\r\n"]
[9.026414, "o", "\u001b[1;33m$ grep -n cgltf_result_unsupported_extension\\|cgltf_result_invalid_compressed_data ../cgltf.h\u001b[0m\r\n"]
[10.03076, "o", "131:\tcgltf_result_unsupported_extension,       /* A used extension has no decoder available (e.g. meshopt support compiled out). */\r\n132:\tcgltf_result_invalid_compressed_data,     /* Extension data failed to decode (corrupt or truncated stream). */\r\n"]
[10.030852, "o", "872: * and cgltf_load_buffers reports cgltf_result_unsupported_extension instead of handing\r\n1563:\treturn cgltf_result_unsupported_extension;\r\n1572:\t\treturn cgltf_result_unsupported_extension;\r\n1616:\t\t\t\treturn cgltf_result_unsupported_extension;\r\n1618:\t\t\treturn cgltf_result_invalid_compressed_data;\r\n"]
[11.03402, "o", "\u001b[1;33m$ ./build/cgltf_test_nohook build/meshopt-fixtures/ext.gltf\u001b[0m\r\n"]
[12.041863, "o", "Result: 10\r\n"]
